# Copie para .env na raiz do site na Hostinger (junto de index.html)
# Nao commite o .env com senhas reais.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu@gmail.com
SMTP_PASS=senha_de_app_16_caracteres
SMTP_FROM="LiberaAI <seu@gmail.com>"
ALERT_EMAIL_TO=contato@liberaai.com.br

# Webhook Pluga / RD Station (opcional)
RD_WEBHOOK_URL=

# Google Tag Manager (opcional)
GTM_ID=

# Senha para POST /api/test-smtp
ADMIN_PASSWORD=sua_senha_segura
